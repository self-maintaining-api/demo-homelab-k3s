# Copy to terraform.tfvars (ignored by git) and fill in your network.
ip_cidr     = "10.0.0.20/24"
gateway     = "10.0.0.1"
dns_servers = ["10.0.0.1", "1.1.1.1"]

# Optional, to change a default (variables.tf has them all):
# memory_mb = 5120
# cores     = 4
# vm_id     = 130
# ssh_public_key_file = "~/.ssh/id_ed25519.pub"
